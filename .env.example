# Copy this file to .env and put your real key there. Never commit .env.
GROQ_API_KEY=your-groq-api-key-here
# Any Groq model that supports tool use, e.g. llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile
MCP_SERVER_URL=http://127.0.0.1:8000/mcp
# Optional: MCP_TRANSPORT=http | stdio, MCP_HOST=127.0.0.1, MCP_PORT=8000
